# ---- Database -----------------------------------------------------------
# Neon (produksi/Workers): postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Lokal/dev: postgresql://postgres:postgres@localhost:5432/rawatin
DATABASE_URL=postgres://USERNAME:PASSWORD@HOST:PORT/rawatin

# ---- Session / security -------------------------------------------------
# Panjang acak, minimal 32 karakter. Ganti di produksi!
SESSION_SECRET=change-me-to-a-long-random-string-32-chars-min
PIN_SALT=change-me-too

# ---- App ----------------------------------------------------------------
APP_BASE_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173

# ---- Cloudflare R2 (opsional saat dev; dipakai di Worker) ---------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_PRESIGN_SECONDS=600

# ---- Cloudflare / Workers env (jika deploy via wrangler) ----------------
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ---- Sentry (opsional) --------------------------------------------------
VITE_SENTRY_DSN=
SENTRY_DSN=

# ---- Analytics (Umami, opsional) ----------------------------------------
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_HOST=
